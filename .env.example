# ─── Wiftgram Casino ────────────────────────────────────────────────────────────
# Скопируй файл в .env и подставь свои значения (start.cmd делает это сам).

# Токен бота из @BotFather (обязательно)
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Твой user_id — хозяин казино (если 0, хозяином станет первый, кто напишет /start)
OWNER_ID=0

# Публичный HTTPS-адрес мини-приложения (можно оставить пустым: tunnel.cmd подставит сам)
PUBLIC_URL=
# Стабильный вход через GitHub Pages. Если задан, бот даёт ссылку на эту
# страницу, а она перенаправляет на текущий HTTPS-бэкенд из параметра u.
GITHUB_PAGES_URL=

# Локальные порты
PORT=8080
HTTPS_PORT=8443

# Режим получения обновлений: polling | webhook | off
BOT_MODE=polling

# Секрет в пути вебхука (если BOT_MODE=webhook): /webhook/<секрет>
WEBHOOK_SECRET=

# Проверка аккаунта.
# ВАЖНО: текущие сборки Wiftgram не передают подписанный initData в WebApp,
# поэтому жёсткий режим 1 блокирует вход у всех. Оставь 0 для Wiftgram.
# 0 (по умолчанию) — совместимый режим: id из WebApp проверяется, если клиент его отдаёт;
# 1 — жёстко требовать подписанный initData (только если клиент его действительно шлёт).
STRICT_ACCOUNT_CHECK=1
# Свежесть initData при входе (по умолчанию 30 минут)
AUTH_MAX_AGE_MS=1800000
# Время жизни сессии мини-приложения (по умолчанию 12 часов)
SESSION_TTL_MS=43200000

# Настройки API (менять не нужно)
API_BASE=https://api.wiftgram.ru
API_TIMEOUT_MS=60000

# Самоподписанный сертификат для локального HTTPS
PFX_PATH=
PFX_PASS=wiftgram
